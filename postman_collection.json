    {
      "name": "Manajemen Sistem",
      "item": [
        {
          "name": "Universal Toggle Status (sp_toggle_status - Manajer)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"entitas\": \"akun\",\n    \"id\": 2,\n    \"is_active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sistem/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sistem",
                "status"
              ]
            }
          }
        }
      ]
    }
