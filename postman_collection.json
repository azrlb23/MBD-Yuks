{
  "info": {
    "name": "POS Kafe Jalur Langit API Collection",
    "description": "Postman Collection resmi dan lengkap untuk pengujian seluruh 14 endpoint API POS Kafe Jalur Langit (7 Tabel Bahasa Indonesia, Auth, Roles, RLS, 13 Stored Procedures, & 3 Trigger). Setiap request dilengkapi body JSON yang akurat dan realistis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autentikasi User Access (UC-00)",
      "item": [
        {
          "name": "Login Kasir (sp_login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"kasir1\",\n  \"password\": \"kasir123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login sebagai Kasir menggunakan Stored Procedure `sp_login`. Token JWT yang dikembalikan otomatis disimpan ke variabel `{{token}}`."
          }
        },
        {
          "name": "Login Manajer (sp_login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manajer1\",\n  \"password\": \"manajer123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login sebagai Manajer menggunakan Stored Procedure `sp_login`. Token JWT yang dikembalikan otomatis disimpan ke variabel `{{token}}`."
          }
        },
        {
          "name": "Logout Pengguna",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "    pm.collectionVariables.set('token', '');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Logout dari sesi saat ini dan mengosongkan variabel `{{token}}`."
          }
        }
      ]
    },
    {
      "name": "2. Katalog & Detail Barang (UC-01 & UC-03)",
      "item": [
        {
          "name": "Get Katalog Barang (sp_get_katalog_barang)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/barang",
              "host": ["{{baseUrl}}"],
              "path": ["barang"]
            },
            "description": "Membaca seluruh katalog menu kafe aktif via View `vw_katalog_barang` & REFCURSOR `sp_get_katalog_barang`."
          }
        },
        {
          "name": "Get Detail Barang ID 1 (sp_get_detail_barang)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/barang/1",
              "host": ["{{baseUrl}}"],
              "path": ["barang", "1"]
            },
            "description": "Membaca detail 1 barang (termasuk stok & JSONB spesifikasi varian) via `sp_get_detail_barang`."
          }
        },
        {
          "name": "Update Harga & Spesifikasi (sp_update_harga_spesifikasi - Manajer)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"harga\": 24000.00,\n  \"spesifikasi\": {\n    \"suhu\": [\"dingin\", \"panas\"],\n    \"tingkat_gula\": [\"normal\", \"sedikit\", \"tanpa_gula\"],\n    \"biji_kopi\": \"Arabika Gayo Single Origin\",\n    \"jenis_susu\": [\"susu_sapi_full_cream\", \"susu_oat_almond\"],\n    \"catatan_barista\": \"Rekomendasi disajikan dingin dengan es batu kristal\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/barang/1",
              "host": ["{{baseUrl}}"],
              "path": ["barang", "1"]
            },
            "description": "Manajer memperbarui harga dan penggabungan (merge) JSONB spesifikasi menu via `sp_update_harga_spesifikasi` & `fn_merge_spesifikasi`."
          }
        }
      ]
    },
    {
      "name": "3. Transaksi & Struk Digital (UC-01)",
      "item": [
        {
          "name": "Checkout Pesanan Menu (sp_checkout_transaksi - Kasir)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id_barang\": 1,\n      \"jumlah\": 2\n    },\n    {\n      \"id_barang\": 4,\n      \"jumlah\": 1\n    },\n    {\n      \"id_barang\": 6,\n      \"jumlah\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaksi/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["transaksi", "checkout"]
            },
            "description": "Kasir melakukan checkout pesanan multi-item via Stored Procedure `sp_checkout_transaksi`. Stok dipotong otomatis via Trigger `trg_kurang_stok` dan dokumen Struk Digital JSONB diterbitkan."
          }
        },
        {
          "name": "Get Transaksi Harian (sp_get_transaksi_harian)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/transaksi",
              "host": ["{{baseUrl}}"],
              "path": ["transaksi"]
            },
            "description": "Membaca rekap daftar transaksi hari ini via View `vw_transaksi_harian` & Stored Procedure `sp_get_transaksi_harian`."
          }
        },
        {
          "name": "Get Detail Struk Digital JSONB (sp_get_detail_struk)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/transaksi/struk/1",
              "host": ["{{baseUrl}}"],
              "path": ["transaksi", "struk", "1"]
            },
            "description": "Membaca snapshot dokumen Struk Digital berformat JSONB utuh via `fn_get_detail_struk` & `sp_get_detail_struk`."
          }
        }
      ]
    },
    {
      "name": "4. Restock Stok Barang (UC-02)",
      "item": [
        {
          "name": "Restock Stok Barang (sp_restock_barang - Manajer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_barang\": 1,\n  \"jumlah_tambah\": 50,\n  \"nama_supplier\": \"PT Biji Kopi Nusantara Utama\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restock",
              "host": ["{{baseUrl}}"],
              "path": ["restock"]
            },
            "description": "Manajer mencatat penambahan stok porsi menu via Stored Procedure `sp_restock_barang`. Stok barang otomatis bertambah di tabel `barang` via Trigger `trg_tambah_stok_restock`."
          }
        },
        {
          "name": "Get Laporan Restock (sp_get_laporan_restock)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/restock/riwayat",
              "host": ["{{baseUrl}}"],
              "path": ["restock", "riwayat"]
            },
            "description": "Membaca laporan riwayat jurnal penyesuaian stok porsi menu via View `vw_laporan_restock` & `sp_get_laporan_restock`."
          }
        }
      ]
    },
    {
      "name": "5. Manajemen Akun & Privilege (UC-04)",
      "item": [
        {
          "name": "Get Daftar Akun Pengguna (sp_get_daftar_pengguna - Manajer)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/akun",
              "host": ["{{baseUrl}}"],
              "path": ["akun"]
            },
            "description": "Manajer membaca seluruh daftar pengguna aktif di sistem via View `vw_daftar_pengguna` & Stored Procedure `sp_get_daftar_pengguna`."
          }
        },
        {
          "name": "Buat Akun Kasir Baru (sp_buat_akun_kasir - Manajer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"kasir_shift_siang\",\n  \"password\": \"PasswordKasir2026!\",\n  \"nama_lengkap\": \"Budi Rahardjo (Kasir Shift Siang)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/akun/kasir",
              "host": ["{{baseUrl}}"],
              "path": ["akun", "kasir"]
            },
            "description": "Manajer membuat akun pengguna Kasir baru beserta enkripsi password hash via Stored Procedure `sp_buat_akun_kasir`."
          }
        },
        {
          "name": "Konfigurasi Privilege User (sp_atur_privilege - Manajer)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"kasir_shift_siang\",\n  \"aksi\": \"GRANT\",\n  \"objek\": \"EXECUTE ON PROCEDURE sp_checkout_transaksi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/akun/privilege",
              "host": ["{{baseUrl}}"],
              "path": ["akun", "privilege"]
            },
            "description": "Manajer mengatur hak akses privilege GRANT/REVOKE pada objek basis data untuk pengguna via Stored Procedure `sp_atur_privilege`."
          }
        },
        {
          "name": "Nonaktifkan Akun User (sp_nonaktifkan_akun - Manajer)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/akun/3",
              "host": ["{{baseUrl}}"],
              "path": ["akun", "3"]
            },
            "description": "Manajer menonaktifkan (`is_active = FALSE`) akun pengguna berdasarkan `id_pengguna` via Stored Procedure `sp_nonaktifkan_akun`."
          }
        }
      ]
    }
  ]
}
