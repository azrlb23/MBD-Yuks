{
  "info": {
    "name": "POS Kafe Jalur Langit API Collection",
    "description": "Postman Collection resmi dan lengkap untuk pengujian seluruh 17 endpoint API POS Kafe Jalur Langit. Termasuk Autentikasi, CRUD Barang, Kategori, Transaksi, Restock, dan Manajemen Akun.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autentikasi User Access (UC-00)",
      "item": [
        {
          "name": "Login Kasir (sp_login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"kasir1\",\n  \"password\": \"kasir123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login sebagai Kasir menggunakan Stored Procedure `sp_login`. Token JWT yang dikembalikan otomatis disimpan ke variabel `{{token}}`."
          }
        },
        {
          "name": "Login Manajer (sp_login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manajer1\",\n  \"password\": \"manajer123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login sebagai Manajer menggunakan Stored Procedure `sp_login`. Token JWT yang dikembalikan otomatis disimpan ke variabel `{{token}}`."
          }
        },
        {
          "name": "Logout Pengguna",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "    pm.collectionVariables.set('token', '');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Logout dari sesi saat ini dan mengosongkan variabel `{{token}}`."
          }
        }
      ]
    },
    {
      "name": "2. Katalog & Detail Barang (UC-01 & UC-03)",
      "item": [
        {
          "name": "Get Katalog Barang (sp_get_katalog_barang)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/barang",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "barang"
              ]
            },
            "description": "Membaca seluruh katalog menu kafe aktif via View `vw_katalog_barang` & REFCURSOR `sp_get_katalog_barang`."
          }
        },
        {
          "name": "Get Detail Barang ID 1 (sp_get_detail_barang)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/barang/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "barang",
                "1"
              ]
            },
            "description": "Membaca detail 1 barang (termasuk stok & JSONB spesifikasi varian) via `sp_get_detail_barang`."
          }
        },
        {
          "name": "Update Harga & Spesifikasi (sp_update_harga_spesifikasi - Manajer)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"harga\": 24000.00,\n  \"spesifikasi\": {\n    \"suhu\": [\"dingin\", \"panas\"],\n    \"tingkat_gula\": [\"normal\", \"sedikit\", \"tanpa_gula\"],\n    \"biji_kopi\": \"Arabika Gayo Single Origin\",\n    \"jenis_susu\": [\"susu_sapi_full_cream\", \"susu_oat_almond\"],\n    \"catatan_barista\": \"Rekomendasi disajikan dingin dengan es batu kristal\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/barang/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "barang",
                "1"
              ]
            },
            "description": "Manajer memperbarui harga dan penggabungan (merge) JSONB spesifikasi menu via `sp_update_harga_spesifikasi` & `fn_merge_spesifikasi`."
          }
        },
        {
          "name": "Tambah Barang Baru (sp_tambah_barang - Manajer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_barang\": \"Kopi Hitam Legendaris\",\n  \"id_kategori\": 1,\n  \"harga\": 15000.00,\n  \"stok\": 100,\n  \"spesifikasi\": {\n    \"suhu\": [\"panas\"],\n    \"biji_kopi\": \"Robusta\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/barang",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "barang"
              ]
            },
            "description": "Manajer menambahkan menu barang baru ke dalam sistem via Stored Procedure `sp_tambah_barang`."
          }
        }
      ]
    },
    {
      "name": "2.5 Manajemen Kategori Barang",
